import { describe, it, expect } from "vitest"
import { pageSchema } from "./page.ts"
import { samplePage } from "./fixtures.ts"

const clone = () => structuredClone(samplePage) as any; // Can switch to interface

describe("pageSchema", () => {

  // test to accept sample page
  it("accepts the sample page", () => {
    expect(pageSchema.safeParse(samplePage).success)
      .toBe(true);
  });

  // switched to componentType enum so no need to test that
  // compiler will cry about it

  it.each(["About Us", "/about", "about/us", "ABOUT", "-about", ""])(
    "reject invalid slug %j",
    (slug: string) => {
      const page = clone();
      page.slug = slug;
      expect(pageSchema.safeParse(page).success)
        .toBe(false);
    }
  );

  it.each(["api", "admin"])("rejects reserved slugs",
    (slug: string) => {
      const page = clone();
      page.slug = slug;
      expect(pageSchema.safeParse(page).success)
        .toBe(false);
    });

  it("allows homepage slug", () => {
    const page = clone();
    page.slug = "/";
    expect(pageSchema.safeParse(page).success)
      .toBe(true);
  });

  it("rejects dupes", () => {
    const page = clone();
    // check added on id in page.ts
    page.components[1].id = page.components[0].id; // creating a dupe
    const result = pageSchema.safeParse(page);

    expect(result.success)
      .toBe(false);

    if (!result.success) {
      expect(result
        .error
        .issues[0]
        .message)
        .toBe(`Duplicate component id "${page.components[1].id}"`)
    }
  });

  it.each([
    "javascript:alert(1)",
    "data:text/html;base64,AAAA",
    "//evil.com",
    "http://insecure.example",
    "contact",
  ])("unsafe href rejected", (href: string) => {
    const page = clone();
    page.components[0].content.ctaHref = href; // modify the content to false type
    expect(pageSchema.safeParse(page).success)
      .toBe(false);
  });
})
